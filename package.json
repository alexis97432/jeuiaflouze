{
  "name": "pile-ou-crash",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test:e2e": "playwright test --trace off && npm run test:game-browser",
    "test:game-browser": "playwright test -c tests/game/browser/playwright.config.ts --trace off",
    "server:build": "vite build -c server/vite.config.ts",
    "server:start": "node dist-server/main.mjs",
    "server:dev": "npm run server:build && DEMO=1 ALLOWED_ORIGINS=http://localhost:5173 node dist-server/main.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@fontsource-variable/oswald": "^5.3.0",
    "lucide": "1.66.0"
  }
}
