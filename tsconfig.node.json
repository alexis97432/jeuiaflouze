{
  // Tests et configs : globals Node autorisés. Le code navigateur (src/) est vérifié par
  // tsconfig.json, sans types Node : `process` ou `Buffer` y échouent au typecheck.
  "extends": "./tsconfig.json",
  "compilerOptions": { "types": ["vite/client", "node"] },
  "include": ["src", "tests", "vite.config.ts", "playwright.config.ts"]
}
